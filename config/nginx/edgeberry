# Edgeberry platform site.
#
# Owned by Edgeberry Core. Application routes are not added here, and not
# written by hand into routes.d/ either: they are generated from the registered
# application's manifest. See `edgeberry --register-application`.
#
# Port map:
#   :80    this server, the only publicly bound listener
#   :1208  Edgeberry Device Service (loopback)

server {
    listen      80;
    listen [::]:80;
    server_name _;

    access_log /var/log/nginx/edgeberry.access.log;
    error_log  /var/log/nginx/edgeberry.error.log;

    # Keep redirects on the client's host:port rather than nginx's idea of it.
    absolute_redirect off;

    error_page 404             /errors/404.html;
    error_page 500 502 503 504  /errors/50x.html;

    location /theme/ {
        root /etc/edgeberry;
        try_files $uri @theme_shipped;
    }
    location @theme_shipped {
        root /opt/Edgeberry/share;
    }

    location /errors/ {
        internal;
        root /etc/edgeberry;
        try_files $uri @errors_shipped;
    }
    location @errors_shipped {
        internal;
        root /opt/Edgeberry/share;
    }

    # Application routes, generated from the registered application's manifest.
    # Longest-prefix match means files here take precedence over the catch-all
    # below regardless of include order. An empty directory is not an error.
    include /opt/Edgeberry/Core/config/nginx/routes.d/*.conf;

    # Catch-all: root and every unclaimed path go to the Device Service.
    location / {
        proxy_pass http://127.0.0.1:1208;
        include /opt/Edgeberry/Core/config/nginx/proxy_params;
        proxy_intercept_errors on;
    }
}
