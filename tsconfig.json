{
  /*
   *  TypeScript configuration for the device software.
   *
   *  Emits CommonJS into build/, which is what the systemd unit runs directly
   *  (/usr/bin/node /opt/Edgeberry/Core/build/main.js). The web interface has
   *  its own configuration under webui/ — it targets a browser and shares
   *  nothing with this one.
   *
   *  This file was the `tsc --init` template: thirteen settings that mattered
   *  buried in ninety lines of commented-out ones that did not. Only the
   *  settings actually in force are kept, each with the reason it is set.
   */
  "compilerOptions": {
    /*
     *  The device runs Node 22, which has had native async/await since v8.
     *  Targeting ES2016 made tsc downlevel every `async` function into a
     *  __awaiter generator state machine — 24 of them in networkManager.js
     *  alone — which costs an allocation per call and drops the async frames
     *  that make a stack trace worth reading.
     */
    "target": "es2022",

    /*
     *  "node16" resolution, which needs "module" set to match.
     *
     *  The old spelling here was "node", renamed to "node10" in TypeScript 5.0
     *  and deprecated outright — it stops working in TypeScript 7. "node16" is
     *  the supported replacement: it resolves the way Node itself does,
     *  honouring the "exports" maps in dependencies rather than guessing at
     *  file paths.
     *
     *  Emit is unaffected. package.json declares no "type", so this package is
     *  CommonJS and these files still compile to require()/exports — the same
     *  build/main.js the systemd unit runs.
     */
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "src",
    "outDir": "build",

    /* Node's types only. Nothing here runs in a browser, and picking up DOM
       globals by accident would let code that cannot work typecheck anyway. */
    "types": ["node"],

    /* Deployment copies build/ onto the device wholesale, so a compilation
       that failed to typecheck must not leave something runnable behind. */
    "noEmitOnError": true,

    /* Without these, a stack trace from a device in the field names a line in
       build/*.js. Node only reads them when started with --enable-source-maps;
       see the note in the systemd unit. */
    "sourceMap": true,
    "removeComments": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },

  "include": ["src/**/*"],
  /* build/ is already outside the include, and sdk/ is a separate package with
     its own tsconfig — naming both keeps an editor from wandering into them. */
  "exclude": ["node_modules", "build", "sdk"]
}
